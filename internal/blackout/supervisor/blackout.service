# Example systemd unit for the Blackout supervisor (see the package documentation).
#
# Setup:
#   1. Make a user "blackout" with the home directory /var/lib/blackout.
#   2. Clone KVLite into /var/lib/blackout/kvlite with a deploy key that has read-only access.
#      The runner fetches and never pushes.
#      Only the runner uses this checkout, because follow mode checks out each new commit in it.
#   3. Compile the supervisor:
#        cd /var/lib/blackout/kvlite && go build -o /var/lib/blackout/bin/blackout-supervisor ./internal/blackout/supervisor
#   4. Copy this file to /etc/systemd/system/blackout.service and change the paths.
#   5. Start the service: systemctl enable --now blackout
#   6. Optional, for an automatic GitHub issue for each new error: add -issues OWNER/NAME to ExecStart,
#      and write GITHUB_TOKEN=TOKEN into /etc/blackout/github.env (mode 0600, owner root).
#      A fine-grained token with the permission "Issues: Read and write" on the repository is enough.
#
# The status is in /var/lib/blackout/results/status.json, and the log is in journalctl -u blackout.

[Unit]
Description=Blackout deterministic simulation runner for KVLite
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blackout
Group=blackout
WorkingDirectory=/var/lib/blackout
Environment=HOME=/var/lib/blackout
Environment=GOCACHE=/var/lib/blackout/.cache/go-build
Environment=PATH=/usr/local/go/bin:/usr/bin:/bin
# The token for automatic GitHub issues, if the file exists; systemd reads it as root, so only root can read the file.
EnvironmentFile=-/etc/blackout/github.env
ExecStart=/var/lib/blackout/bin/blackout-supervisor -repo /var/lib/blackout/kvlite -out /var/lib/blackout/results -follow

# Restart the supervisor when it stops.
Restart=always
RestartSec=60s

# Low priority: the runner uses only the CPU time and the disk time that other programs do not need.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# The cgroup of the service is idle too (cgroup v2 cpu.idle).
# Without it, the service competes with each other service at the normal cgroup weight, also when its threads are idle.
CPUWeight=idle

# A stop sends SIGTERM to the supervisor only.
# The supervisor then lets the running workers finish, and systemd kills them after TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=6min

# Hard limits of the kernel for the supervisor, its workers, and the compile together.
# The supervisor plans its workers in half of MemoryMax, and the kernel stops a worker that grows past the plan before a sample sees it.
MemoryMax=50%
MemorySwapMax=0
# When the server has no memory left, the kernel kills a worker first, so the other programs survive.
OOMScoreAdjust=1000
# The workers use all CPUs, but at the lowest priority, so they get only the CPU time that other programs do not need.
# Some VPS plans do not allow full CPU use for a long time.
# For a hard CPU limit, set CPUQuota, where 100% is one CPU, for example CPUQuota=100% on 2 CPUs.
#CPUQuota=100%

# The service writes only in its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackout

[Install]
WantedBy=multi-user.target
